# Real models for docker compose --profile gpu (copy to .env in the repository root).
# Leave PORTAL_LLM_PROVIDER empty so the worker calls the model instead of the demo analyst.
PORTAL_LLM_PROVIDER=
PORTAL_LLM_BASE_URL=http://llm:8000/v1
PORTAL_LLM_MODEL=deepdive-llm
PORTAL_EMBEDDINGS_BASE_URL=http://embeddings:8000/v1
PORTAL_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-4B
# Used only when AI Configuration → Retrieval → rerank is on.
PORTAL_RERANK_BASE_URL=http://reranker:8000/v1
PORTAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Model choice for a single local GPU. Production (Helm) uses Qwen3.8-27B in FP8 on a 96 GB card.
LLM_MODEL=Qwen/Qwen3-8B
LLM_MAX_LEN=32768
