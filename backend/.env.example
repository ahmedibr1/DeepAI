# Copy to .env for local development. In Kubernetes these come from a Secret / ConfigMap.
PORTAL_ENVIRONMENT=development
PORTAL_DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5432/portal
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_JWT_SECRET=replace-with-a-random-48-byte-value
PORTAL_SESSION_MINUTES=60
# Must be true behind TLS (production). false only for http://localhost development.
PORTAL_COOKIE_SECURE=false
PORTAL_LOGIN_MAX_ATTEMPTS=5
PORTAL_LOCKOUT_MINUTES=15
PORTAL_RETENTION_DAYS=0

# Documents
PORTAL_STORAGE_BACKEND=local
PORTAL_LOCAL_STORAGE_PATH=./.documents
PORTAL_MAX_UPLOAD_MB=100
# For S3-compatible storage instead:
# PORTAL_STORAGE_BACKEND=s3
# PORTAL_S3_ENDPOINT_URL=https://s3.internal.example
# PORTAL_S3_BUCKET=presales-portal-documents
# PORTAL_S3_ACCESS_KEY_ID / PORTAL_S3_SECRET_ACCESS_KEY come from a Kubernetes Secret

# AI (Phase 3)
PORTAL_LLM_PROVIDER=demo                  # rule-based analyst, no GPU — demonstrations and pipeline testing only
# For the real on-premises model instead (unset PORTAL_LLM_PROVIDER):
# PORTAL_LLM_BASE_URL=http://presales-portal-llm:8000/v1
# PORTAL_LLM_MODEL=deepdive-llm
# PORTAL_EMBEDDINGS_BASE_URL=http://presales-portal-embeddings:8000/v1
# PORTAL_EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-4B
